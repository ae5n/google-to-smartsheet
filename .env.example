# Server Configuration
PORT=3001
NODE_ENV=development
HTTPS_PORT=3443

# Number of reverse proxies in front of the app, or 'loopback' when there are
# none. Set to 1 behind a single nginx/ALB, 2 behind Cloudflare + nginx.
# Do not set it higher than the real hop count: each extra hop lets a client
# forge one more X-Forwarded-For entry and spoof its identity.
TRUST_PROXY=loopback

# Database — Postgres connection string. Use a pooled connection string if your
# provider offers one, so a long-running server does not exhaust direct
# connections.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_POOL_SIZE=10
# Mark a running job failed after this many minutes without persisted progress.
STALE_TRANSFER_MINUTES=15
# Optional audit retention; 0 keeps transfer history indefinitely.
TRANSFER_HISTORY_RETENTION_DAYS=0

ENCRYPTION_KEY=your-256-bit-encryption-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Smartsheet API
SMARTSHEET_CLIENT_ID=your-smartsheet-client-id
SMARTSHEET_CLIENT_SECRET=your-smartsheet-client-secret

# Session Configuration
SESSION_SECRET=your-session-secret-key-here

# HTTPS Certificates (for development)
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt

# Application URLs
BASE_URL=https://localhost:3443
CLIENT_URL=https://localhost:3000

# Security
CSRF_SECRET=your-csrf-secret-here
JWT_SECRET=your-jwt-secret-here

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
